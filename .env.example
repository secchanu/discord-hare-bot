# Discord Bot Token
DISCORD_BOT_TOKEN=your_bot_token_here

# Guild ID (single-guild bot)
DISCORD_GUILD_ID=123456789012345678

# Channel IDs
DISCORD_READY_CHANNEL_ID=123456789012345678
DISCORD_WANTED_CHANNEL_ID=123456789012345678

# Ignore Roles (format: id:description,id:description,...)
# Example: 123456789012345678:Admin Role,987654321098765432:Bot Role
DISCORD_IGNORE_ROLES=

# Claude API Key (optional, enables answering game questions)
# Requires Message Content Intent in the Discord Developer Portal
ANTHROPIC_API_KEY=
# Assistant Model (default: claude-opus-5-5)
ASSISTANT_MODEL=
